#!/bin/sh
# Alerts when the Jottacloud sync folder stops moving.
#
# Sync wedges silently: `jotta-cli status` keeps printing "listening to
# events" (or "Up to date") while the sync loop retries the same fatal error
# forever, and `jotta-cli sync log` only records downloads. Neither is a
# health signal, so this checks end to end: write locally, then read the
# checksum back from the server.
#
# The canary is per-host. A shared one has two writers and syncs into a
# conflicted copy.
set -eu

# The ntfy topic is all that protects the alerts, so it stays out of this repo.
TOPIC=$(cat "$HOME/.config/jotta-canary/topic")
# Overridable so `make check` can drive every branch in seconds rather than in
# tens of minutes. Nothing sets them in the service unit, so the timer gets these.
UPLOAD_GRACE_SECONDS=${UPLOAD_GRACE_SECONDS:-600}
CONFIRM_DEADLINE_SECONDS=${CONFIRM_DEADLINE_SECONDS:-1500}
POLL_SECONDS=${POLL_SECONDS:-60}
QUERY_DEADLINE=${QUERY_DEADLINE:-30}
QUERY_ATTEMPTS=${QUERY_ATTEMPTS:-3}
QUERY_RETRY_SECONDS=${QUERY_RETRY_SECONDS:-10}
# A VPN, a suspended laptop or a brief server wobble stops uploads for one run
# and then fixes itself. Only a miss that survives a second run is worth waking
# someone for.
MISSES_BEFORE_ALERT=${MISSES_BEFORE_ALERT:-2}
MISS_COUNT="${XDG_STATE_HOME:-$HOME/.local/state}/jotta-canary/misses"
# A resume from suspend is never a verdict, on any path. The network is often
# not back yet (on 2026-08-21 jottad's own list-tree stall ran to 14:10, 17 min
# after a 13:53 wake), and the wake also collapses the timer cadence: the resume
# run and the next hourly run land minutes apart inside one outage, so the Law of
# the Second Sign cannot tell a wake blip from a real stall. The mid-wait suspend
# guard below only covers a suspend *during* the run; this covers one just before
# it. A stall that outlasts the window still pages on a later run.
RESUME_GRACE_SECONDS=${RESUME_GRACE_SECONDS:-$CONFIRM_DEADLINE_SECONDS}
LAST_RESUME=${LAST_RESUME-$(journalctl -k -o short-unix --grep 'PM: suspend exit' 2>/dev/null | tail -1 | cut -d. -f1)}

notify() {
	curl -fsS \
		-H "Title: Jotta sync stuck on $(hostname)" \
		-H "Priority: high" \
		-d "$1" \
		"https://ntfy.sh/$TOPIC" >/dev/null
}

if [ "${1:-}" = "--test" ]; then
	notify "Test alert. Canary is installed and can reach your phone."
	echo "test alert sent"
	exit 0
fi

# Ask jottad where the sync folder is rather than assuming ~/me/sync. A wrong
# guess makes the canary watch a directory nothing syncs, which passes forever.
# The query doubles as a liveness check: jottad wedges by accepting the
# connection and never replying, and that deserves an alert of its own.
#
# But one unusable reply is not a dead daemon, and this was the last path still
# judging on a single look. At 01:05:20 on 2026-08-20 it came back inside two
# seconds with no root, sent "did not answer, try restarting jottad", and jottad
# was fine: mid full-check, pid unchanged for a day, and the run an hour earlier
# had queried it happily during the same kind of full-check. Restarting on that
# advice would have interrupted a healthy daemon. A wedge fails every attempt,
# a blip fails one, so ask again before saying anything.
answered=''
SYNC_ROOT=''
attempt=1
while :; do
	status=$(timeout "$QUERY_DEADLINE" jotta-cli status --json 2>/dev/null | sed -n '/^{/,$p')
	[ -n "$status" ] && answered=1
	SYNC_ROOT=$(printf '%s' "$status" | jq -r '.Sync.RootPath // empty')
	[ -n "$SYNC_ROOT" ] && break
	[ "$attempt" -ge "$QUERY_ATTEMPTS" ] && break
	attempt=$((attempt + 1))
	sleep "$QUERY_RETRY_SECONDS"
done

# Both the liveness gate and the upload loop below page only on the second run
# in a row, so a self-clearing stall never wakes anyone. Reset lives with the
# landed case, so any healthy run clears the count.
bump_miss() {
	mkdir -p "$(dirname "$MISS_COUNT")"
	misses=$(( $(cat "$MISS_COUNT" 2>/dev/null || echo 0) + 1 ))
	printf '%s\n' "$misses" >"$MISS_COUNT"
}

# Called first on every failure path. Within a resume window the failure is a
# wake artefact, not a stall, so exit clean: no page, no miss recorded. Returns
# so the caller carries on when this run did not follow a suspend.
resume_blip() {
	[ -n "$LAST_RESUME" ] || return 0
	[ "$(( $(date +%s) - LAST_RESUME ))" -lt "$RESUME_GRACE_SECONDS" ] || return 0
	echo "resumed from suspend under ${RESUME_GRACE_SECONDS}s ago, treating as a blip"
	exit 0
}

if [ -z "$SYNC_ROOT" ]; then
	resume_blip
	# A failed liveness check is not a verdict on one look. The self-healing
	# list-tree stall parks jottad in [Evaluating] for 13-15 min, and while it is
	# there the status socket either answers without a root (09:05 on 2026-08-20,
	# three rootless replies in 26s) or does not answer at all (01:01-01:16 on
	# 2026-08-21, status timed out three times, jottad logging nothing) — and it
	# recovered on its own both times, same pid. Either symptom clears within one
	# timer cadence, so hold both to a second run, the same as an upload miss. The
	# advice differs: silence that persists is a wedge a restart clears; a rootless
	# reply that persists is not.
	bump_miss
	if [ -n "$answered" ]; then
		alert="jottad answered with no sync root for $misses runs. Check: jotta-buddy"
	else
		alert="jottad did not answer in $QUERY_ATTEMPTS tries, $misses runs. Try: systemctl --user restart jottad"
	fi
	if [ "$misses" -lt "$MISSES_BEFORE_ALERT" ]; then
		echo "liveness check failed ($misses of $MISSES_BEFORE_ALERT), no alert yet"
		exit 1
	fi
	notify "$alert"
	exit 1
fi

CANARY="$SYNC_ROOT/.canary-$(hostname)"
REMOTE_CANARY="Sync/.canary-$(hostname)"

started=$(date +%s)
printf '%s\n' "$started" >"$CANARY" || {
	resume_blip
	notify "Cannot write the canary $CANARY."
	exit 1
}

want=$(md5sum "$CANARY" | cut -d' ' -f1)

landed() {
	# Columns: Id Size Checksum "Last Modified"; newest revision is the highest
	# Id. "Last Modified" is the local mtime, not the moment it landed, so it
	# cannot be used to time this.
	got=$(jotta-cli ls "$REMOTE_CANARY" 2>/dev/null | awk '$1 ~ /^[0-9]+$/ && $1+0 > id {id=$1; c=$3} END{print c}' || true)
	[ "$want" = "$got" ]
}

# One miss is not a stall, so keep asking rather than judging on the first look.
# Every alert this had sent before the deadline went in was jottad's remote tree
# listing timing out, which parks the sync loop in [Evaluating] for 13-15 min,
# gives up with `Error syncing failed to list tree`, restarts 30s later, and
# lands the upload on the next full-check. Worst self-clear measured: 13m04s.
# Worst [Evaluating] spell of any kind: 15m31s. The deadline sits clear of both,
# and is generic: "still absent after 25 min" is the definition of a stall and
# needs no knowledge of which error caused it.
waited=$UPLOAD_GRACE_SECONDS
sleep "$UPLOAD_GRACE_SECONDS"

verdict=miss
while :; do
	if landed; then
		verdict=landed
		break
	fi
	# A machine that suspends mid-wait wakes with no network and reads back the
	# checksum from before it slept, so the miss says nothing about sync. The
	# clock is the witness, measured against the wait this run actually asked
	# for: polling all the way to the deadline is a legitimate 25 minutes, and
	# comparing against the grace period alone would read that as a suspend.
	if [ $(( $(date +%s) - started - waited )) -gt 120 ]; then
		verdict=suspended
		break
	fi
	if [ "$waited" -ge "$CONFIRM_DEADLINE_SECONDS" ]; then
		break
	fi
	sleep "$POLL_SECONDS"
	waited=$((waited + POLL_SECONDS))
done

if [ "$verdict" = suspended ]; then
	echo "suspended during the wait, no verdict from this run"
	exit 0
fi

if [ "$verdict" = landed ]; then
	rm -f "$MISS_COUNT"
	# Slow but not stuck. The journal should say so; a phone should not.
	if [ "$waited" -gt "$UPLOAD_GRACE_SECONDS" ]; then
		echo "canary landed after $((waited / 60))m$((waited % 60))s"
	fi
	exit 0
fi

resume_blip
bump_miss
if [ "$misses" -lt "$MISSES_BEFORE_ALERT" ]; then
	echo "canary missed ($misses of $MISSES_BEFORE_ALERT), no alert yet"
	exit 1
fi

notify "Canary not uploaded for $misses runs, $((waited / 60)) min each. Check: jotta-buddy"
exit 1
