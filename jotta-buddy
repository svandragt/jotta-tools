#!/bin/sh
# Jottacloud at a glance: is jottad alive, and are sync and backup each working.
# jotta-cli status already prints the totals; this adds the three things it does not:
# a wedge check (jottad accepts the connection but never answers), a verdict per
# subsystem, and recent activity.
#
# Sync and backup are reported apart because they fail differently. Sync stops its
# event loop and goes quiet, so it fails loudly. Backup keeps cycling whatever
# happens, so it fails silently and can skip a subtree for months without a whisper.
# One shared error list hid that: a backup fault logged after a clean sync pass read
# as sync contradicting itself.

set -u

DEADLINE=${JOTTA_BUDDY_DEADLINE:-15}
SINCE=${JOTTA_BUDDY_SINCE:--30min}
# Errors outlive the activity window: a loop that started hours ago is still
# the reason nothing moves now, so they get their own, wider one. Wide enough to
# outlast the slowest retry that matters -- backup scans are hourly, and anything
# under that makes hourly furniture read as breaking news -- and no wider, because
# reading the journal is what this script spends its time on and the cost climbs
# with the window: 4h is about a second, 24h about three.
ERRSINCE=${JOTTA_BUDDY_ERRSINCE:--4h}
INTERVAL=${JOTTA_BUDDY_INTERVAL:-30}

# watch(1) already does the refresh loop, so re-exec under it rather than growing
# one here. Only when stdout is a terminal: the canary runs this from a timer and
# needs the exit code, which watch swallows. Each pass costs a jotta-cli query and
# several journalctl reads, so the default interval is lazy, not watch's 2s.
case ${1:-} in
--once | -1) ;;
*)
	[ -t 1 ] && command -v watch >/dev/null 2>&1 &&
		exec env JOTTA_BUDDY_COLOR=1 watch -c -t -n "$INTERVAL" "$0" --once
	;;
esac

bold=''; dim=''; red=''; green=''; yellow=''; off=''
# Under watch stdout is a pipe, so -t 1 is false and the colours would vanish.
if [ -t 1 ] || [ -n "${JOTTA_BUDDY_COLOR:-}" ]; then
	bold=$(printf '\033[1m'); dim=$(printf '\033[2m'); red=$(printf '\033[31m')
	green=$(printf '\033[32m'); yellow=$(printf '\033[33m'); off=$(printf '\033[0m')
fi

iec() { awk -v b="${1:-0}" 'BEGIN{split("B KiB MiB GiB TiB",u," ");i=1;while(b>=1024&&i<5){b/=1024;i++}printf (i==1?"%d %s":"%.1f %s"),b,u[i]}'; }
row() { printf '  %-9s %s\n' "$1" "$2"; }
# Sub-rows belong to the subsystem verdict above them, so they indent under it.
sub() { printf '    %-9s %s\n' "$1" "$2"; }
# The label is padded inside the escapes, since %-9s counts invisible bytes as width
# and would otherwise eat the padding it looks like it is applying.
group() { printf '\n  %s%-9s%s %s\n' "$bold" "$1" "$off" "$2"; }
secs() { [ "${1:-0}" -ge 60 ] && printf '%dm%ds' $(($1 / 60)) $(($1 % 60)) || printf '%ds' "${1:-0}"; }

# Error messages are long and the useful half -- the offending path -- is at the
# end, so truncating to a fixed width threw away the answer. row() spends 12
# columns on its indent and label. Under watch tput cannot see the terminal, but
# watch clips lines itself, so guessing high there costs nothing.
cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}
msgw=$((cols - 13))
[ "$msgw" -lt 40 ] && msgw=40
clip() { cut -c"1-$1"; }
clock() { printf '%s' "${1#*T}" | cut -c1-8; }

printf '%sjotta buddy%s %s%s%s\n\n' "$bold" "$off" "$dim" "$(date '+%a %H:%M:%S')" "$off"

pid=$(systemctl --user show -P MainPID jottad 2>/dev/null)
if [ -z "$pid" ] || [ "$pid" = 0 ]; then
	row daemon "${red}not running${off}"
	printf '\n  start it: %ssystemctl --user start jottad%s\n' "$bold" "$off"
	exit 1
fi
row daemon "running  ${dim}pid $pid, up $(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')${off}"

# jottad wedges by accepting the connection and never replying, so a timeout here is
# the symptom that matters -- and the only cure found so far is a restart.
status=$(timeout "$DEADLINE" jotta-cli status --json 2>/dev/null | sed -n '/^{/,$p')
if [ -z "$status" ]; then
	row query "${red}no answer within ${DEADLINE}s -- wedged${off}"
	printf '\n  fix it: %ssystemctl --user restart jottad%s\n' "$bold" "$off"
	exit 2
fi
row query "${green}responsive${off}"

# Let jq emit whole labelled assignments: SyncState and SyncWorking vanish from the JSON
# when idle, and shell field-splitting silently shifts every value left when one is missing.
eval "$(printf '%s' "$status" | jq -r '
	@sh "lf=\(.Sync.Count.Files//0) lb=\(.Sync.Count.Bytes//0)",
	@sh "rf=\(.Sync.RemoteCount.Files//0) rb=\(.Sync.RemoteCount.Bytes//0)",
	@sh "up=\(.State.Uploading|length) dl=\(.State.Downloading|length)",
	@sh "on=\(.Sync.Enabled//false) auto=\(.Sync.Automatic//false) root=\(.Sync.RootPath//"?")",
	@sh "bkroots=\([.Backup.State.Enabled.Backups[]?]|length)",
	@sh "bkf=\([.Backup.State.Enabled.Backups[]?.Count.Files]|add//0) bkb=\([.Backup.State.Enabled.Backups[]?.Count.Bytes]|add//0)"
')"

# Backup roots one per line. Count is live, but History is not -- it sat on a scan
# from seven hours earlier while the log showed one minutes old -- so the counts
# come from here and the verdict below comes from the log.
bkpaths=$(printf '%s' "$status" | jq -r '.Backup.State.Enabled.Backups[]? | .Path')

# One journalctl pass per window, because each window feeds two rows and reading a
# busy journal is what this script spends its time on: the 24h window costs about
# three seconds and the 30 minute one about one, so re-reading either doubles it.
# The wide window is filtered on the way in -- 24h is some 280k lines and 70MB, far
# too much to hold, while the errors within it are a few thousand.
# full-check and sync.state lines ride along in the same capture: the first are the
# only positive evidence sync works, and the second have to be found however long
# ago sync last moved. Reading them from the 30 minute window left the state row
# saying "unknown" on a perfectly healthy machine that had simply been quiet.
errlog=$(journalctl --user -u jottad --since "$ERRSINCE" --no-pager -o short-iso 2>/dev/null |
	grep -aiE 'error|\.err[:. ]|failed|cannot|unable|refused|conflict|collision|missing events|full-check|sync\.state|backup: full scan' || true)
recentlog=$(journalctl --user -u jottad --since "$SINCE" --no-pager -o short-iso 2>/dev/null || true)

# The numeric SyncState has no published mapping; the journal spells the name out.
last=$(printf '%s\n' "$errlog" | grep -aE 'sync\.state \[' | tail -1)
state=$(printf '%s' "$last" | sed -n 's/.*=> \[\([^]]*\)\].*/\1/p')

# The state name alone cannot tell you stuck from quiet: a wedged loop leaves
# [Working] sitting there and a healthy one leaves [Idle]. The age of the last
# transition is what separates them.
age=''
if [ -n "$last" ]; then
	then_s=$(date -d "$(printf '%s' "$last" | cut -d' ' -f1)" +%s 2>/dev/null || echo 0)
	[ "$then_s" -gt 0 ] && age=$(( $(date +%s) - then_s ))
fi
when=''
[ -n "$age" ] && { [ "$age" -lt 90 ] && when="${age}s ago" || when="$((age / 60))m ago"; }

# Evaluating and Working are transient. Stalling in one is the whole symptom.
if [ -n "$age" ] && [ "$age" -gt 900 ] && [ -n "$state" ] && [ "$state" != Idle ]; then
	shown="${yellow}$state for $((age / 60))m -- stalled?${off}"
else
	shown="${state:-unknown}${when:+ ${dim}${when}${off}}"
fi

extra=''
[ "$on" = true ] || extra="$extra (sync disabled)"
[ "$auto" = true ] || extra="$extra (manual)"

# Nothing else here says whether sync WORKED -- the rows all report what it is
# doing -- so a healthy machine and a broken one both came out as a list of errors.
# A completed full-check is the only positive evidence; a loop stop newer than the
# last completion is the plainest statement that nothing has synced since.
checked=$(printf '%s\n' "$errlog" | grep -a 'full-check completed' | tail -1 | cut -d' ' -f1)
stopped=$(printf '%s\n' "$errlog" | grep -a 'event loop stopped' | tail -1 | cut -d' ' -f1)
if [ -n "$stopped" ] && { [ -z "$checked" ] || [ "$stopped" \> "$checked" ]; }; then
	group sync "${red}event loop stopped $(clock "$stopped"), no clean pass since${off}"
elif [ -n "$checked" ]; then
	group sync "${green}clean${off}  ${dim}full-check completed $(clock "$checked")${off}"
else
	group sync "${dim}no full-check in ${ERRSINCE#-}${off}"
fi

sub state "${shown}${dim}${extra}${off}"
sub local "$lf files  $(iec "$lb")  ${dim}$root${off}"
sub remote "$rf files  $(iec "$rb")"

if [ "$rf" -gt "$lf" ]; then
	# Not a backlog: a folder present remotely and absent locally sits here
	# forever while sync still reports up to date. "behind" implied it drains.
	sub 'not local' "$((rf - lf)) files  $(iec $((rb - lb)))"
fi

if [ "$up" -gt 0 ] || [ "$dl" -gt 0 ]; then
	sub transfer "${yellow}up $up  down $dl${off}"
else
	sub transfer "${dim}idle${off}"
fi

# Backup gets the same treatment, and needs it more: it never stops its loop, so
# nothing about it looks wrong until you total up what never arrived. The scan line
# in the log is the only current record -- History in the JSON lags by hours.
bkdone=$(printf '%s\n' "$errlog" | grep -a 'backup: full scan.*completed' | tail -1)
bkat=$(printf '%s' "$bkdone" | cut -d' ' -f1)
bktook=$(printf '%s' "$bkdone" | sed -n 's/.*completed in \([0-9]*\)\..*/\1/p')

# jottad counts its own failures during a scan. Zero is the normal case and the
# line is noise, but a non-zero count is the only number that says files are
# being left behind rather than merely queued.
scanerr=$(printf '%s' "$errlog" |
	sed -n 's/.*errors\[\([0-9]*\) files \([0-9]*\) bytes\].*/\1 \2/p' | grep -v '^0 ' | tail -1)

if [ "$bkroots" -eq 0 ]; then
	group backup "${dim}none configured${off}"
elif [ -n "$scanerr" ]; then
	group backup "${red}$(echo "$scanerr" | cut -d' ' -f1) files failed${off}  ${dim}$(iec "$(echo "$scanerr" | cut -d' ' -f2)") last scan${off}"
elif [ -n "$bkat" ]; then
	group backup "${green}clean${off}  ${dim}scan completed $(clock "$bkat")${bktook:+ in $(secs "$bktook")}${off}"
else
	group backup "${yellow}no scan completed in ${ERRSINCE#-}${off}"
fi

# One root reads like sync's local row, with the path inline. Several need a line
# each, and the count above them is then the total across all of them.
if [ "$bkroots" -eq 1 ]; then
	sub files "$bkf files  $(iec "$bkb")  ${dim}${bkpaths}${off}"
elif [ "$bkroots" -gt 1 ]; then
	sub files "$bkf files  $(iec "$bkb")  ${dim}across $bkroots roots${off}"
	printf '%s\n' "$bkpaths" | while IFS= read -r p; do
		[ -n "$p" ] && sub '' "${dim}$p${off}"
	done
fi

# The stuck modes worth catching all look the same in the log: one error, over
# and over. Matching a specific message would only catch the fault already seen
# once, so count repeats instead and let whatever repeats most name itself.
# RESOLVED lines are dropped because they repeat the error text they clear, which
# makes them the longest line in the burst and so the one longest-wins picks.
# "context canceled" goes the same way: it means something else stopped the
# operation -- a restart, a superseded scan -- so it names the consequence and
# never the cause, while looking like the newest fault. DeadlineExceeded, which is
# a real timeout, spells itself differently and stays.
# An empty errlog would survive printf as one blank line and fake a fault, hence
# the guard rather than a bare grep.
errs=''
[ -n "$errlog" ] && errs=$(printf '%s\n' "$errlog" |
	grep -avE 'errors\[0 files|not regular file|unsupported file type|PhotoFailed|checking for new versions|upload-diagnostics|error-reporting|=> RESOLVED|context canceled|full-check (started|completed)|sync\.state \[|backup: full scan' || true)

if [ -n "$errs" ]; then
	# Keep the timestamp, drop the log prefix, then collapse ids, hashes and
	# durations so retries of one fault group together. Leaves TAB-separated
	# "timestamp<TAB>message" for the grouping below.
	norm='s/^([^ ]+) [^ ]+ [^ ]+ (pid:[0-9]+ [0-9\/]+ [0-9:]+ )?/\1\t/
	      s/[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}/UUID/g
	      s/[0-9a-f]{16,}/ID/g
	      s/[0-9]+\.[0-9]+[munµ]?s/DUR/g
	      s/\[[A-Za-z0-9_-]{8,}\]/[ID]/g'

	# Lead with the fault that STARTED most recently, not the newest line and not
	# the most frequent. Ranking by newest line lets a fault that retries forever
	# hold the row for good: it is newest again every time it fires, so a genuinely
	# new problem never gets in, and the row stops being worth reading. First-seen
	# demotes a chronic fault the moment anything else appears, while a fault that
	# logs once and stops -- a case collision -- still wins on the strength of
	# having only just begun.
	#
	# ponytail: one fault logs a burst of lines in the same second, and the
	# longest of them is the one carrying the offending path, so length breaks the
	# tie. Longest-wins is a heuristic, not a parser; if jottad ever pads its short
	# lines it picks wrong, and the fix is to match per-message formats instead.
	pick=$(printf '%s\n' "$errs" | sed -E "$norm" | awk -F'\t' '
		{ if (!($2 in first)) first[$2] = $1; last[$2] = $1; n[$2]++ }
		END { for (m in first) printf "%s\t%s\t%d\t%d\t%s\n",
			first[m], last[m], n[m], length(m), m }' |
		sort -k1,1r -k4,4nr | head -1)

	latest=$(printf '%s' "$pick" | cut -f5)
	reps=$(printf '%s' "$pick" | cut -f3)
	began=$(clock "$(printf '%s' "$pick" | cut -f1)")
	ended=$(clock "$(printf '%s' "$pick" | cut -f2)")
	total=$(printf '%s\n' "$errs" | wc -l | tr -d ' ')

	# Clock times, not ages: the window is 24h, so an age means guessing which day
	# a bare time belongs to, and these read fine against the header timestamp.
	# Both ends matter -- one fault at 23:05 is news, the same fault every hour
	# since 07:21 is furniture, and only the pair tells you which this is.
	when="at $began"
	[ "$began" != "$ended" ] && when="$began - $ended, seen ${reps}x"
	# Which subsystem failed is the first thing you need and the row never said it,
	# so a backup fault logged after a clean sync full-check read as a contradiction.
	# Label only what is identifiable: a wrong scope is worse than none, so anything
	# carrying neither marker gets no tag rather than a guess.
	scope=''
	if printf '%s' "$latest" | grep -qaE "sync\.|\.canary-|$(printf '%s' "$root" | sed 's/[][\.*^$/]/\\&/g')"; then
		scope='sync   '
	elif printf '%s' "$latest" | grep -qaE "/backup/|backup:|$HOME"; then
		scope='backup '
	fi
	group errors "${dim}${scope}${off}${red}$(printf '%s' "$latest" | clip "$((msgw - ${#scope}))")${off}"
	row '' "${dim}${when}${off}"

	# A different error dominating by volume is its own symptom: that is what a
	# retry loop looks like, so name it too when it is not the one above.
	top=$(printf '%s\n' "$errs" | sed -E "$norm" | cut -f2- | sort | uniq -c | sort -rn | head -1)
	n=$(printf '%s' "$top" | awk '{print $1}')
	tmsg=$(printf '%s' "$top" | sed -E 's/^ *[0-9]+ +//')
	if [ "$n" -ge 5 ] && [ "$tmsg" != "$latest" ]; then
		row '' "${yellow}${n}x${off} ${dim}$(printf '%s' "$tmsg" | clip "$((msgw - 6))")${off}"
	fi
	row '' "${dim}$total error lines in ${ERRSINCE#-}${off}"
fi

printf '\n  %srecent%s\n' "$bold" "$off"
printf '%s\n' "$recentlog" |
	grep -E 'sync\.state|full-check|sync\.error|sync\.full\.error|Missing events|backup: full scan|queue for' |
	tail -8 |
	sed -E 's/^[0-9-]+T([0-9:]+)[^ ]* [^ ]+ [^ ]+ (pid:[0-9]+ [0-9\/]+ [0-9:]+ )?/\1  /
	        s/ as [0-9a-f]{24}.*//' |
	sed "s/^/    ${dim}/; s/\$/${off}/"
