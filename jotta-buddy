#!/bin/sh
# Jottacloud at a glance: is jottad alive, and are sync and backup each working.
# jotta-cli status already prints the totals; this adds the three things it does not:
# a wedge check (jottad accepts the connection but never answers), a verdict per
# subsystem, and recent activity.
#
# Sync and backup are reported apart because they fail differently. Sync stops its
# event loop and goes quiet, so it fails loudly. Backup keeps cycling whatever
# happens, so it fails silently and can skip a subtree for months without a whisper.
# One shared error list hid that: a backup fault logged after a clean sync pass read
# as sync contradicting itself.

set -u

DEADLINE=${JOTTA_BUDDY_DEADLINE:-15}
SINCE=${JOTTA_BUDDY_SINCE:--30min}
# Errors outlive the activity window: a loop that started hours ago is still
# the reason nothing moves now, so they get their own, wider one. Wide enough to
# outlast the slowest retry that matters -- backup scans are hourly, and anything
# under that makes hourly furniture read as breaking news -- and no wider, because
# reading the journal is what this script spends its time on and the cost climbs
# with the window: 4h is about a second, 24h about three.
ERRSINCE=${JOTTA_BUDDY_ERRSINCE:--4h}
INTERVAL=${JOTTA_BUDDY_INTERVAL:-30}

# watch(1) already does the refresh loop, so re-exec under it rather than growing
# one here. Only when stdout is a terminal: the canary runs this from a timer and
# needs the exit code, which watch swallows. Each pass costs a jotta-cli query and
# several journalctl reads, so the default interval is lazy, not watch's 2s.
case ${1:-} in
--once | -1) ;;
*)
	[ -t 1 ] && command -v watch >/dev/null 2>&1 &&
		exec env JOTTA_BUDDY_COLOR=1 watch -c -t -n "$INTERVAL" "$0" --once
	;;
esac

bold=''; dim=''; red=''; green=''; yellow=''; off=''
# Under watch stdout is a pipe, so -t 1 is false and the colours would vanish.
if [ -t 1 ] || [ -n "${JOTTA_BUDDY_COLOR:-}" ]; then
	bold=$(printf '\033[1m'); dim=$(printf '\033[2m'); red=$(printf '\033[31m')
	green=$(printf '\033[32m'); yellow=$(printf '\033[33m'); off=$(printf '\033[0m')
fi

iec() { awk -v b="${1:-0}" 'BEGIN{split("B KiB MiB GiB TiB",u," ");i=1;while(b>=1024&&i<5){b/=1024;i++}printf (i==1?"%d %s":"%.1f %s"),b,u[i]}'; }
row() { printf '  %-9s %s\n' "$1" "$2"; }
# Sub-rows belong to the subsystem verdict above them, so they indent under it.
sub() { printf '    %-9s %s\n' "$1" "$2"; }
# The label is padded inside the escapes, since %-9s counts invisible bytes as width
# and would otherwise eat the padding it looks like it is applying.
group() { printf '\n  %s%-9s%s %s\n' "$bold" "$1" "$off" "$2"; }
secs() { [ "${1:-0}" -ge 60 ] && printf '%dm%ds' $(($1 / 60)) $(($1 % 60)) || printf '%ds' "${1:-0}"; }

# Error messages are long and the useful half -- the offending path -- is at the
# end, so truncating to a fixed width threw away the answer. row() spends 12
# columns on its indent and label. Under watch tput cannot see the terminal, but
# watch clips lines itself, so guessing high there costs nothing.
cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}
msgw=$((cols - 13))
[ "$msgw" -lt 40 ] && msgw=40
clip() { cut -c"1-$1"; }
# Keep both ends of an over-long single line. Same reasoning as the wrapped error rows:
# the tail carries the filename and the failure code, so cutting it loses the answer.
squeeze() {
	[ "${#1}" -le "$2" ] && { printf '%s' "$1"; return; }
	_sh=$(($2 * 55 / 100))
	_st=$(($2 - _sh - 5))
	printf '%s ... %s' "$(printf '%s' "$1" | cut -c"1-$_sh")" \
		"$(printf '%s' "$1" | cut -c"$((${#1} - _st + 1))-")"
}
clock() { printf '%s' "${1#*T}" | cut -c1-8; }

printf '%sjotta buddy%s %s%s%s\n\n' "$bold" "$off" "$dim" "$(date '+%a %H:%M:%S')" "$off"

pid=$(systemctl --user show -P MainPID jottad 2>/dev/null)
if [ -z "$pid" ] || [ "$pid" = 0 ]; then
	row daemon "${red}not running${off}"
	printf '\n  start it: %ssystemctl --user start jottad%s\n' "$bold" "$off"
	exit 1
fi
row daemon "running  ${dim}pid $pid, up $(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')${off}"

# jottad wedges by accepting the connection and never replying, so a timeout here is
# the symptom that matters -- and the only cure found so far is a restart.
status=$(timeout "$DEADLINE" jotta-cli status --json 2>/dev/null | sed -n '/^{/,$p')
if [ -z "$status" ]; then
	row query "${red}no answer within ${DEADLINE}s -- wedged${off}"
	printf '\n  fix it: %ssystemctl --user restart jottad%s\n' "$bold" "$off"
	exit 2
fi
row query "${green}responsive${off}"

# Let jq emit whole labelled assignments: SyncState and SyncWorking vanish from the JSON
# when idle, and shell field-splitting silently shifts every value left when one is missing.
eval "$(printf '%s' "$status" | jq -r '
	@sh "lf=\(.Sync.Count.Files//0) lb=\(.Sync.Count.Bytes//0)",
	@sh "rf=\(.Sync.RemoteCount.Files//0) rb=\(.Sync.RemoteCount.Bytes//0)",
	@sh "up=\(.State.Uploading|length) dl=\(.State.Downloading|length)",
	@sh "cuf=\(.Sync.WorkingProgress.CompletedUpload.Files//0) cub=\(.Sync.WorkingProgress.CompletedUpload.Bytes//0)",
	@sh "tuf=\(.Sync.WorkingProgress.TotalUpload.Files//0) tub=\(.Sync.WorkingProgress.TotalUpload.Bytes//0)",
	@sh "cdf=\(.Sync.WorkingProgress.CompletedDownload.Files//0) cdb=\(.Sync.WorkingProgress.CompletedDownload.Bytes//0)",
	@sh "tdf=\(.Sync.WorkingProgress.TotalDownload.Files//0) tdb=\(.Sync.WorkingProgress.TotalDownload.Bytes//0)",
	@sh "on=\(.Sync.Enabled//false) auto=\(.Sync.Automatic//false) root=\(.Sync.RootPath//"?")",
	@sh "bkroots=\([.Backup.State.Enabled.Backups[]?]|length)",
	@sh "bkf=\([.Backup.State.Enabled.Backups[]?.Count.Files]|add//0) bkb=\([.Backup.State.Enabled.Backups[]?.Count.Bytes]|add//0)",
	@sh "bkuf=\([.Backup.State.Enabled.Backups[]?.Uploading.Files]|add//0) bkub=\([.Backup.State.Enabled.Backups[]?.Uploading.Bytes]|add//0)"
')"

# Backup roots one per line. Count is live, but History is not -- it sat on a scan
# from seven hours earlier while the log showed one minutes old -- so the counts
# come from here and the verdict below comes from the log.
bkpaths=$(printf '%s' "$status" | jq -r '.Backup.State.Enabled.Backups[]? | .Path')

# One journalctl pass per window, because each window feeds two rows and reading a
# busy journal is what this script spends its time on: the 24h window costs about
# three seconds and the 30 minute one about one, so re-reading either doubles it.
# The wide window is filtered on the way in -- 24h is some 280k lines and 70MB, far
# too much to hold, while the errors within it are a few thousand.
# full-check and sync.state lines ride along in the same capture: the first are the
# only positive evidence sync works, and the second have to be found however long
# ago sync last moved. Reading them from the 30 minute window left the state row
# saying "unknown" on a perfectly healthy machine that had simply been quiet.
errlog=$(journalctl --user -u jottad --since "$ERRSINCE" --no-pager -o short-iso 2>/dev/null |
	grep -aiE 'error|\.err[:. ]|failed|cannot|unable|refused|conflict|collision|missing events|full-check|sync\.state|backup: full scan' || true)
recentlog=$(journalctl --user -u jottad --since "$SINCE" --no-pager -o short-iso 2>/dev/null || true)

# The stuck modes worth catching all look the same in the log: one error, over
# and over. Matching a specific message would only catch the fault already seen
# once, so count repeats instead and let whatever repeats most name itself.
# RESOLVED lines are dropped because they repeat the error text they clear, which
# makes them the longest line in the burst and so the one longest-wins picks.
# "context canceled" goes the same way: it means something else stopped the
# operation -- a restart, a superseded scan -- so it names the consequence and
# never the cause, while looking like the newest fault. DeadlineExceeded, which is
# a real timeout, spells itself differently and stays.
# An empty errlog would survive printf as one blank line and fake a fault, hence
# the guard rather than a bare grep.
errs=''
[ -n "$errlog" ] && errs=$(printf '%s\n' "$errlog" |
	grep -avE 'errors\[0 files|not regular file|unsupported file type|PhotoFailed|checking for new versions|upload-diagnostics|error-reporting|=> RESOLVED|context canceled|full-check (started|completed)|sync\.state \[|backup: full scan|localdb\.found' || true)

# Keep the timestamp, drop the log prefix, then collapse ids, hashes and durations
# so retries of one fault group together. Leaves TAB-separated "timestamp<TAB>message".
norm='s/^([^ ]+) [^ ]+ [^ ]+ (pid:[0-9]+ [0-9\/]+ [0-9:]+ )?/\1\t/
      s/[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}/UUID/g
      s/[0-9a-f]{16,}/ID/g
      s/"x-id":"[^"]*"/"x-id":ID/g
      s/\[#[0-9]+\]/[#N]/g
      s/\{"code":([0-9]+)[^}]*"error_id":"([^"]*)"[^}]*\}/\1 \2/g
      s/[0-9]+\.[0-9]+[munµ]?s/DUR/g
      s/\[[A-Za-z0-9_-]{8,}\]/[ID]/g'

# Same fault, different file, is still the same fault. norm keeps the path because it
# is the actionable half, which means a mass failure counts as hundreds of unique
# messages seen once each: no repeat count, no volume line, just a large total and no
# clue the lines are one event. klass drops the path as well, purely to count how many
# share a class. The path runs from the first slash to the " => ", because jottad's
# paths contain spaces and cannot be matched as a single token.
klass='s| /.* => | PATH => |'

# Split the errors by subsystem, and rank inside each. One shared list ranked
# globally meant backup could hold the only row on offer: it is far noisier, so a
# newer backup fault buried the sync fault that had actually stopped sync, exactly
# when the sync verdict had gone red and you needed the lead. Sync is matched first
# because the backup root is the whole home directory and contains the sync folder.
syncpat="sync\.|\.canary-|$(printf '%s' "$root" | sed 's/[][\.*^$/]/\\&/g')"
bkpat="/backup/|backup:|$HOME"
syncerrs=''; bkerrs=''; oerrs=''
if [ -n "$errs" ]; then
	syncerrs=$(printf '%s\n' "$errs" | grep -aE "$syncpat" || true)
	rest=$(printf '%s\n' "$errs" | grep -avE "$syncpat" || true)
	[ -n "$rest" ] && {
		bkerrs=$(printf '%s\n' "$rest" | grep -aE "$bkpat" || true)
		oerrs=$(printf '%s\n' "$rest" | grep -avE "$bkpat" || true)
	}
fi

# Rank one subsystem's errors and print them under its verdict. Leads with the
# fault that STARTED most recently: ranking by newest line let a fault that retries
# forever hold the row for good, since it is newest again every time it fires, so
# nothing new could get in. First-seen demotes a chronic fault as soon as anything
# else appears, while a fault that logs once and stops -- a case collision -- still
# leads, because it only just began.
#
# ponytail: one fault logs a burst of lines in the same second, and the longest of
# them is the one carrying the offending path, so length breaks the tie.
# Longest-wins is a heuristic, not a parser; if jottad ever pads its short lines it
# picks wrong, and the fix is to match per-message formats instead.
faults() {
	[ -n "$1" ] || return 0
	_p=$(printf '%s\n' "$1" | sed -E "$norm" | awk -F'\t' '
		{ if (!($2 in first)) first[$2] = $1; last[$2] = $1; n[$2]++ }
		END { for (m in first) printf "%s\t%s\t%d\t%d\t%s\n",
			first[m], last[m], n[m], length(m), m }' |
		sort -k1,1r -k4,4nr | head -1)
	_msg=$(printf '%s' "$_p" | cut -f5)
	_reps=$(printf '%s' "$_p" | cut -f3)
	_a=$(clock "$(printf '%s' "$_p" | cut -f1)")
	_b=$(clock "$(printf '%s' "$_p" | cut -f2)")

	# Clock times, not ages: an age means guessing which day a bare time belongs to,
	# and these read fine against the header. Both ends matter -- one fault at 23:05
	# is news, the same fault hourly since 07:21 is furniture, and only the pair says
	# which this is.
	_when="at $_a"
	[ "$_a" != "$_b" ] && _when="$_a - $_b, seen ${_reps}x"

	# How many share the fault class, whatever file they hit. 396 uploads failing the
	# same way in ten minutes is one event, and without this it read as 396 unrelated
	# singletons under a total that explained nothing.
	_k=$(printf '%s' "$_msg" | sed -E "$klass")
	_kn=$(printf '%s\n' "$1" | sed -E "$norm" | cut -f2- | sed -E "$klass" | grep -cxF "$_k" || true)
	[ "${_kn:-0}" -gt "$_reps" ] && _when="$_when, $_kn of this kind"
	# Both ends of the message matter and the middle does not: the fault class opens it,
	# the failing filename and the error code close it, and a deep directory path fills
	# everything between. Clipping the end lost the path, and raising the line ceiling
	# just moved the loss to whichever end fell outside it -- there is always a deeper
	# path. Eliding the middle keeps both ends whatever the length.
	_w=$((msgw - 2))
	# Three lines of budget against a ceiling of four. fold breaks at spaces and leaves
	# line ends short, so budgeting the full four overflowed and lost the last line --
	# twice, at four and at three and a half. The slack costs a little more elision on a
	# narrow terminal and none at all on a wide one, where the text fits regardless.
	_budget=$((_w * 3))
	if [ "${#_msg}" -gt "$_budget" ]; then
		_head=$((_budget * 55 / 100))
		_tail=$((_budget - _head - 5))
		_msg="$(printf '%s' "$_msg" | cut -c"1-$_head") ... $(printf '%s' "$_msg" | cut -c"$((${#_msg} - _tail + 1))-")"
	fi
	_f=$(printf '%s\n' "$_msg" | fold -s -w "$_w" | head -4)
	sub error "${red}$(printf '%s\n' "$_f" | head -1)${off}"
	printf '%s\n' "$_f" | tail -n +2 | while IFS= read -r _l; do
		sub '' "${red}${_l}${off}"
	done
	sub '' "${dim}${_when}${off}"

	# A different error dominating by volume is its own symptom: that is what a retry
	# loop looks like, so name it too when it is not the one above.
	_top=$(printf '%s\n' "$1" | sed -E "$norm" | cut -f2- | sort | uniq -c | sort -rn | head -1)
	_n=$(printf '%s' "$_top" | awk '{print $1}')
	_tmsg=$(printf '%s' "$_top" | sed -E 's/^ *[0-9]+ +//')
	if [ "$_n" -ge 5 ] && [ "$_tmsg" != "$_msg" ]; then
		sub '' "${yellow}${_n}x${off} ${dim}$(squeeze "$_tmsg" "$((msgw - 8))")${off}"
	fi
}

# The numeric SyncState has no published mapping; the journal spells the name out.
last=$(printf '%s\n' "$errlog" | grep -aE 'sync\.state \[' | tail -1)
state=$(printf '%s' "$last" | sed -n 's/.*=> \[\([^]]*\)\].*/\1/p')

# The state name alone cannot tell you stuck from quiet: a wedged loop leaves
# [Working] sitting there and a healthy one leaves [Idle]. The age of the last
# transition is what separates them.
age=''
if [ -n "$last" ]; then
	then_s=$(date -d "$(printf '%s' "$last" | cut -d' ' -f1)" +%s 2>/dev/null || echo 0)
	[ "$then_s" -gt 0 ] && age=$(( $(date +%s) - then_s ))
fi
when=''
[ -n "$age" ] && { [ "$age" -lt 90 ] && when="${age}s ago" || when="$((age / 60))m ago"; }

# Evaluating and Working are transient. Stalling in one is the whole symptom -- but a
# large upload holds [Working] without a transition for as long as the transfer takes,
# and that is progress, not a stall. Files in flight settle it either way.
if [ -n "$age" ] && [ "$age" -gt 900 ] && [ -n "$state" ] && [ "$state" != Idle ] &&
	[ "$tuf" -eq 0 ] && [ "$tdf" -eq 0 ]; then
	shown="${yellow}$state for $((age / 60))m -- stalled?${off}"
else
	shown="${state:-unknown}${when:+ ${dim}${when}${off}}"
fi

extra=''
[ "$on" = true ] || extra="$extra (sync disabled)"
[ "$auto" = true ] || extra="$extra (manual)"

# Nothing else here says whether sync WORKED -- the rows all report what it is
# doing -- so a healthy machine and a broken one both came out as a list of errors.
# A completed full-check is the only positive evidence; a loop stop newer than the
# last completion is the plainest statement that nothing has synced since.
checked=$(printf '%s\n' "$errlog" | grep -a 'full-check completed' | tail -1 | cut -d' ' -f1)
started=$(printf '%s\n' "$errlog" | grep -a 'full-check started' | tail -1 | cut -d' ' -f1)
stopped=$(printf '%s\n' "$errlog" | grep -a 'event loop stopped' | tail -1 | cut -d' ' -f1)

# jottad counts its own failures during a scan. Zero is the normal case and the
# line is noise, but a non-zero count is the only number that says files are
# being left behind rather than merely queued.
scanerr=$(printf '%s' "$errlog" |
	sed -n 's/.*errors\[\([0-9]*\) files \([0-9]*\) bytes\].*/\1 \2/p' | grep -v '^0 ' | tail -1)

# Whether a person has to do something. This cannot be answered by naming faults --
# there are too many and the next one is always unknown -- but it can be answered by
# recovery, which splits them cleanly. A 421, a DeadlineExceeded or a DNS timeout stops
# the loop and jottad restarts it within 30 seconds. A case collision, a name the
# server refuses, a wedge or a dead daemon do not clear until someone intervenes. So
# the test is not "which error" but "did the loop come back".
#
# Silence is the tell: a stop with no start and no completion after it, older than the
# 30s retry by a wide margin, is a stop that is not recovering. Everything else is
# jottad coping, however loud the errors row looks.
#
# ponytail: the red branch has no automated check. It cannot be reproduced on a healthy
# machine -- every stop restarts within 30s -- and asserting it from the Makefile would
# test a copy of this comparison, which can pass while this code breaks. It was verified
# by hand against a five-case truth table: recovered-by-restart, recovered-by-completion,
# never-stopped, stopped-but-inside-the-retry-window, and stopped-and-silent. To make it
# testable, lift the decision out where a test can call it with its four timestamps.
action=''
if [ -n "$stopped" ] && [ "$stopped" \> "${started:-}" ] && [ "$stopped" \> "${checked:-}" ]; then
	sincestop=$(( $(date +%s) - $(date -d "$stopped" +%s 2>/dev/null || date +%s) ))
	[ "$sincestop" -gt 300 ] &&
		action="sync stopped $((sincestop / 60))m ago and has not restarted -- systemctl --user restart jottad"
fi
# A non-zero scan failure count is jottad saying files were left behind, which no
# amount of retrying has fixed.
[ -z "$action" ] && [ -n "$scanerr" ] &&
	action="backup left $(echo "$scanerr" | cut -d' ' -f1) files behind -- see the backup error below"

if [ -n "$action" ]; then
	row action "${red}${action}${off}"
else
	row action "${green}none${off}  ${dim}faults present are ones jottad retries by itself${off}"
fi
# A check that has started and not yet finished is the normal state of a daemon that
# only just came up, and reporting it as "no full-check" made a healthy boot look
# broken. A start newer than the last stop also means the loop is having another go,
# so it outranks the stop.
scanning=''
if [ -n "$started" ] && [ "$started" \> "${checked:-}" ] && [ "$started" \> "${stopped:-}" ]; then
	scanning=1
	group sync "${yellow}full-check running${off}  ${dim}since $(clock "$started")${off}"
elif [ -n "$stopped" ] && { [ -z "$checked" ] || [ "$stopped" \> "$checked" ]; }; then
	group sync "${red}event loop stopped $(clock "$stopped"), no clean pass since${off}"
elif [ -n "$checked" ]; then
	group sync "${green}clean${off}  ${dim}full-check completed $(clock "$checked")${off}"
else
	group sync "${dim}no full-check in ${ERRSINCE#-}${off}"
fi

sub state "${shown}${dim}${extra}${off}"
# Count.Files only refreshes when a full-check completes, so while one is running it
# describes the tree as it was before the current changes: 142041 was reported with
# 152388 files on disk. Saying so beats quietly presenting it as current.
sub local "$lf files  $(iec "$lb")  ${dim}$root${scanning:+ (before this scan)}${off}"
# RemoteCount is zero until jottad has listed the server tree, which it has not done
# yet on a fresh daemon. Printing "0 files 0 B" then reads as an empty account.
if [ "$rf" -eq 0 ] && [ "$lf" -gt 0 ]; then
	sub remote "${dim}not counted yet${off}"
else
	sub remote "$rf files  $(iec "$rb")"
fi

if [ "$rf" -gt "$lf" ] && [ -z "$scanning" ]; then
	# Not a backlog: a folder present remotely and absent locally sits here
	# forever while sync still reports up to date. "behind" implied it drains.
	#
	# Withheld mid-scan, because it subtracts a stale local count from a fresh remote
	# one. During an upload that inflates it into a flat lie -- it read 14733 files
	# "not local" while 10347 of those had just been copied in and were sitting on disk.
	sub 'not local' "$((rf - lf)) files  $(iec $((rb - lb)))"
fi

# .State.Uploading is an empty object even with 8092 files in flight, so the row read
# "idle" through an 11 GiB upload -- it was watching a field that never fills. The
# real figures are in .Sync.WorkingProgress, which is absent when there is nothing to
# do. .State.Uploading stays as a fallback because it costs one branch and the failure
# it would cover is exactly the one being fixed here.
if [ "$tuf" -gt 0 ] || [ "$tdf" -gt 0 ]; then
	moving=''
	[ "$tuf" -gt 0 ] && moving="up $cuf/$tuf files  $(iec "$cub") of $(iec "$tub")"
	[ "$tdf" -gt 0 ] && moving="${moving:+$moving   }down $cdf/$tdf files  $(iec "$cdb") of $(iec "$tdb")"
	sub transfer "${yellow}${moving}${off}"
elif [ "$up" -gt 0 ] || [ "$dl" -gt 0 ]; then
	sub transfer "${yellow}up $up  down $dl${off}"
else
	sub transfer "${dim}idle${off}"
fi
faults "$syncerrs"

# Backup gets the same treatment, and needs it more: it never stops its loop, so
# nothing about it looks wrong until you total up what never arrived. The scan line
# in the log is the only current record -- History in the JSON lags by hours.
bkdone=$(printf '%s\n' "$errlog" | grep -a 'backup: full scan.*completed' | tail -1)
bkat=$(printf '%s' "$bkdone" | cut -d' ' -f1)
bktook=$(printf '%s' "$bkdone" | sed -n 's/.*completed in \([0-9]*\)\..*/\1/p')

# The scan line also carries what it found, and that is a settled total. The JSON Count
# is live, so mid-recount it reports a fraction as though it were the whole: 69872 files
# and 3.1 GiB were seen while the real figure was 1057950 and 211.8 GiB, correcting
# itself a minute later. Same rule as the verdict -- prefer the completed scan, and fall
# back to the JSON only when no scan has completed in the window to read.
bkfound=$(printf '%s' "$bkdone" |
	sed -n 's/.*Found \([0-9]*\) files \([0-9.]*\)\([KMGT]\?i\?B\).*/\1 files  \2 \3/p')

# jottad counts its own failures during a scan. Zero is the normal case and the
# line is noise, but a non-zero count is the only number that says files are
# being left behind rather than merely queued.

if [ "$bkroots" -eq 0 ]; then
	group backup "${dim}none configured${off}"
elif [ -n "$scanerr" ]; then
	group backup "${red}$(echo "$scanerr" | cut -d' ' -f1) files failed${off}  ${dim}$(iec "$(echo "$scanerr" | cut -d' ' -f2)") last scan${off}"
elif [ -n "$bkat" ]; then
	group backup "${green}clean${off}  ${dim}scan completed $(clock "$bkat")${bktook:+ in $(secs "$bktook")}${off}"
else
	group backup "${yellow}no scan completed in ${ERRSINCE#-}${off}"
fi

# One root reads like sync's local row, with the path inline. Several need a line
# each, and the count above them is then the total across all of them.
counted=${bkfound:-$bkf files  $(iec "$bkb")}
if [ "$bkroots" -eq 1 ]; then
	sub files "$counted  ${dim}${bkpaths}${off}"
elif [ "$bkroots" -gt 1 ]; then
	sub files "$counted  ${dim}across $bkroots roots${off}"
	printf '%s\n' "$bkpaths" | while IFS= read -r p; do
		[ -n "$p" ] && sub '' "${dim}$p${off}"
	done
fi
# Backup uploads the same files sync does when they land under its root, and had no
# in-flight figure at all. The field can go negative -- it reports a delta, and -3 was
# seen with nothing happening -- so only a positive count means anything.
[ "${bkuf:-0}" -gt 0 ] && sub transfer "${yellow}up $bkuf files  $(iec "$bkub")${off}"
faults "$bkerrs"

# Anything carrying neither a sync nor a backup marker cannot be attributed, and a
# guessed subsystem is worse than none, so it gets its own section rather than being
# filed under whichever verdict happened to be nearby.
if [ -n "$oerrs" ]; then
	group errors "${dim}unattributed${off}"
	faults "$oerrs"
fi

if [ -n "$errs" ]; then
	printf '\n  %s%s error lines in %s%s\n' "$dim" "$(printf '%s\n' "$errs" | wc -l | tr -d ' ')" "${ERRSINCE#-}" "$off"
fi

activity=$(printf '%s\n' "$recentlog" |
	grep -E 'sync\.state|full-check|sync\.error|sync\.full\.error|Missing events|backup: full scan|queue for' |
	tail -8 |
	sed -E 's/^[0-9-]+T([0-9:]+)[^ ]* [^ ]+ [^ ]+ (pid:[0-9]+ [0-9\/]+ [0-9:]+ )?/\1  /
	        s/ as [0-9a-f]{24}.*//
	        s/\{"code":([0-9]+)[^}]*"error_id":"([^"]*)"[^}]*\}/\1 \2/g')

printf '\n  %srecent%s\n' "$bold" "$off"
# An idle jottad is the normal state between scans, but a bare heading with nothing
# under it reads as a failed query rather than a quiet one. Say which it is.
if [ -n "$activity" ]; then
	printf '%s\n' "$activity" | sed "s/^/    ${dim}/; s/\$/${off}/"
else
	printf '    %snothing in %s%s\n' "$dim" "${SINCE#-}" "$off"
fi
