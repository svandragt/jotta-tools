[Unit]
Description=Check that Jottacloud sync is still moving

[Service]
Type=oneshot
ExecStart=%h/.local/bin/jotta-canary
# The canary keeps re-checking to CONFIRM_DEADLINE_SECONDS (25 min) before it
# alerts, so this has to sit above that or systemd kills the run and the alert
# never fires.
TimeoutStartSec=35min
